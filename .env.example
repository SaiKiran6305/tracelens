# Configure these as Replit Secrets or local environment variables.
# Never commit real credentials or recording-session tokens.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
# Replit managed workflows set PORT. Supply it for a standalone API process.
PORT=3000
